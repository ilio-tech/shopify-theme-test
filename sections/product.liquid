{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product-images">
  {% for image in product.images %}
    {% render 'image', class: 'product-image', image: image %}
  {% endfor %}
</div>

<div class="product-info">
  <h1>{{ product.title }}</h1>
  <p>{{ product.price | money }}</p>
  <p>{{ product.description }}</p>
</div>

<div class="product-form">
  {% form 'product', product %}
    {% assign current_variant = product.selected_or_first_available_variant %}

     <select name="id">
      {% for variant in product.variants %}
        <option
          value="{{ variant.id }}"
          {% if variant == current_variant %}
            selected="selected"
          {% endif %}
          data-size-info="{{ variant.metafields.custom.size_info }}"
          data-inventory="{{ variant.inventory_quantity }}"
          data-available="{{ variant.available }}"
        >
          {{ variant.title }} - {{ variant.price | money }}
        </option>
      {% endfor %}
    </select>

    <input type="number" name="quantity" min="1" value="1">

     <input 
      type="submit" 
      value="Add to cart"
      class="
        {% if current_variant.available %}
          btn-in-stock
        {% else %}
          btn-out-of-stock
        {% endif %}
      "
    >

    {%- if current_variant.inventory_quantity < 5 -%}
      <p class="stock-message stock-low">Low stock</p>
    {%- else -%}
      <p class="stock-message stock-available">Available!</p>
    {%- endif -%}

    {%- if current_variant.metafields.custom.size_info != blank -%}
      <p class="size-info">
        {{ current_variant.metafields.custom.size_info }}
      </p>
    {%- endif -%}

    {{ form | payment_button }}
  {% endform %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var form = document.querySelector('.product-form');
    if (!form) return;

    var select = form.querySelector('select[name="id"]');
    var sizeInfoEl = form.querySelector('.size-info');
    var stockMessageEl = form.querySelector('.stock-message');
    var addToCartBtn = form.querySelector('input[type="submit"]');

    if (!select || !addToCartBtn) return;

    function updateSizeInfo() {
      if (!sizeInfoEl) return;
      var selectedOption = select.options[select.selectedIndex];
      if (!selectedOption) return;

      var text = selectedOption.getAttribute('data-size-info') || '';
      sizeInfoEl.textContent = text;
    }

    function updateStockUI() {
      var selectedOption = select.options[select.selectedIndex];
      if (!selectedOption) return;

      var inventory = parseInt(selectedOption.getAttribute('data-inventory') || '0', 10);
      var availableAttr = selectedOption.getAttribute('data-available');
      var available = (availableAttr === 'true' || availableAttr === '1');

      // Add to cart ボタンの色
      if (available && inventory > 0) {
        addToCartBtn.classList.remove('btn-out-of-stock');
        addToCartBtn.classList.add('btn-in-stock');
      } else {
        addToCartBtn.classList.remove('btn-in-stock');
        addToCartBtn.classList.add('btn-out-of-stock');
      }

      // 在庫メッセージ
      if (!stockMessageEl) return;

      if (!available || inventory <= 0) {
        stockMessageEl.textContent = 'Sold out';
        stockMessageEl.classList.remove('stock-available');
        stockMessageEl.classList.add('stock-low');
      } else if (inventory < 5) {
        stockMessageEl.textContent = 'Low stock';
        stockMessageEl.classList.remove('stock-available');
        stockMessageEl.classList.add('stock-low');
      } else {
        stockMessageEl.textContent = 'Available!';
        stockMessageEl.classList.remove('stock-low');
        stockMessageEl.classList.add('stock-available');
      }
    }

    function handleChange() {
      updateSizeInfo();
      updateStockUI();
    }

    // サイズ切り替え時に両方更新
    select.addEventListener('change', handleChange);

    // 初期表示も現在の選択に合わせる
    handleChange();
  });
</script>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
